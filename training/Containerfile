FROM docker.io/library/python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/workspace/cache/huggingface \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /opt/training
RUN pip install --no-cache-dir --upgrade pip
RUN --mount=type=cache,target=/root/.cache/pip pip install --retries 10 --resume-retries 10 --timeout 120 torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && pip check
COPY *.py ./
COPY local-config.json ./
RUN groupadd --gid 10001 trainer && useradd --uid 10001 --gid trainer --create-home trainer \
    && mkdir -p /workspace && chown trainer:trainer /workspace
USER 10001:10001
CMD ["python", "container_entrypoint.py"]
