# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_ALLOW_MODEL_FALLBACK="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Optional. High-fidelity human speech synthesis engine
ELEVENLABS_API_KEY=""

# ELEVENLABS_VOICE_ID: Optional. Custom cloned voice ID for Apex Twin
ELEVENLABS_VOICE_ID=""

# Phase 2 runtime. LIVE also requires ENABLE_LIVE_EXECUTION=true.
DEPLOYMENT_PROFILE="DEVELOPMENT"
PRODUCTION_HARDENING="true"
OPERATING_MODE="SIMULATION"
ENABLE_LIVE_EXECUTION="false"
INCIDENT_DATA_DIR=".data"
DATABASE_URL=""
KNOWLEDGE_INDEX_DIR=".data/knowledge"
KNOWLEDGE_INDEX_REQUIRED="false"

# OIDC validation. Keep AUTH_REQUIRED=false for the local persona simulator.
AUTH_REQUIRED="false"
ENABLE_LOCAL_PERSONA="false"
OIDC_ISSUER="https://accounts.google.com"
OIDC_AUDIENCE="your-oauth-client-id"
OIDC_JWKS_URI="https://www.googleapis.com/oauth2/v3/certs"
OIDC_ROLE_CLAIM="roles"
OIDC_ALLOWED_ALGORITHMS="RS256"
OIDC_CLOCK_TOLERANCE_SECONDS="30"

SECRET_PROVIDER="ENVIRONMENT"
SECRET_FILE_DIRECTORY="/run/secrets"

# Google Cloud authentication uses Application Default Credentials / Workload Identity.
GOOGLE_CLOUD_PROJECT=""
USE_SECRET_MANAGER="false"
GOOGLE_MONITORING_METRIC_TYPE="compute.googleapis.com/instance/cpu/utilization"

# Read-only connector telemetry is independent of OPERATING_MODE and
# ENABLE_LIVE_EXECUTION. Only the exact value LIVE enables configured vendor
# API polling; absent or invalid values safely fall back to SIMULATION.
TELEMETRY_MODE="SIMULATION"
TELEMETRY_CACHE_TTL_MS="30000"
TELEMETRY_STALE_RETENTION_MS="600000"
TELEMETRY_CONNECTOR_TIMEOUT_MS="12000"
TELEMETRY_FRESHNESS_MS="120000"

# Invisible Digital Twin service worker. It periodically reads enabled
# ServiceNow/telemetry connectors, persists structured evidence, runs the
# explainable cyber-fusion engine, and emits shadow-only recommendations.
DIGITAL_TWIN_WORKER_ENABLED="true"
AGENT_COLLABORATION_VOICE_ENABLED="false"
CYBER_FUSION_ENABLED="true"
CYBER_FUSION_POLL_MS="30000"
CYBER_FUSION_HISTORY_LIMIT="50"
CYBER_FUSION_AUTO_WORK_NOTES="true"

# ServiceNow incident ingest is read-only and must be explicitly enabled in
# LIVE telemetry mode. The token needs only incident table read permission.
SERVICENOW_INCIDENT_INGEST_ENABLED="false"
SERVICENOW_INCIDENT_INGEST_LIMIT="50"
# Optional allowlisted scope values; no free-form encoded query is accepted.
SERVICENOW_ASSIGNED_TO=""
SERVICENOW_ASSIGNMENT_GROUP=""

# Non-secret connector flags, endpoints, and read-only query configuration.
# A connector makes no vendor request unless TELEMETRY_MODE=LIVE and its own
# *_ENABLED flag is true. HTTP is rejected except for localhost endpoints.
DATADOG_ENABLED="false"
DATADOG_API_URL="https://api.datadoghq.com"
DATADOG_METRIC_QUERIES_JSON=""
DATADOG_SECURITY_SIGNALS_ENABLED="false"

SPLUNK_ENABLED="false"
SPLUNK_API_URL=""
SPLUNK_SEARCH_EXPORT_PATH="/services/search/v2/jobs/export"
SPLUNK_METRIC_SEARCHES_JSON=""
SPLUNK_ANOMALY_SEARCH_ENABLED="false"
SPLUNK_ANOMALY_SEARCH=""

SOLARWINDS_ENABLED="false"
SOLARWINDS_API_URL=""
# Native Orion SWIS REST uses Basic auth. BEARER is only for a custom relay or
# deployment that explicitly supports bearer tokens.
SOLARWINDS_AUTH_MODE="BASIC"
SOLARWINDS_NODE_QUERY=""
CISCO_CATALYST_CENTER_ENABLED="false"
CISCO_CATALYST_CENTER_URL=""
CISCO_CATALYST_CENTER_API_VERSION="2.3.7.9"
CISCO_CATALYST_CENTER_DEVICE_SCOPE=""
CISCO_CATALYST_CENTER_CA_FILE=""
CISCO_SDWAN_ENABLED="false"
CISCO_SDWAN_URL=""
CISCO_SDWAN_AUTH_MODE="JWT"
CISCO_SDWAN_TENANT=""
CISCO_SDWAN_CA_FILE=""
FIREWALL_CONNECTORS_ENABLED="false"
FIREWALL_MANAGER_TYPES=""
FIREWALL_DEVICE_SCOPE=""
FIREWALL_CA_BUNDLE_FILE=""

GOOGLE_MONITORING_ENABLED="false"

# Environment fallback names when Secret Manager is disabled. When enabled,
# create secrets with these exact IDs and do not put their values in this file.
SERVICENOW_INSTANCE_URL=""
SERVICENOW_ACCESS_TOKEN=""
SERVICENOW_WORK_NOTE_ACCESS_TOKEN=""

# Diagnostic command plane. The proxy owns device credentials and execution.
COMMAND_PROXY_GRPC_ENDPOINT=""
COMMAND_PROXY_ACCESS_TOKEN=""
COMMAND_PROXY_TIMEOUT_MS="15000"
COMMAND_PROXY_CA_FILE=""
COMMAND_PROXY_CLIENT_CERT_FILE=""
COMMAND_PROXY_CLIENT_KEY_FILE=""

# Read-only telemetry credentials. When USE_SECRET_MANAGER=true, create Google
# Secret Manager secrets with these exact IDs instead of storing values here.
DATADOG_API_KEY=""
DATADOG_APP_KEY=""
SPLUNK_ACCESS_TOKEN=""
# Required when SOLARWINDS_AUTH_MODE=BASIC (the default).
SOLARWINDS_USERNAME=""
SOLARWINDS_PASSWORD=""
# Required only when SOLARWINDS_AUTH_MODE=BEARER.
SOLARWINDS_ACCESS_TOKEN=""
CISCO_CATALYST_CENTER_USERNAME=""
CISCO_CATALYST_CENTER_PASSWORD=""
CISCO_SDWAN_USERNAME=""
CISCO_SDWAN_PASSWORD=""
FIREWALL_CONNECTOR_CREDENTIALS=""

# Multilingual incident voice. Coqui runs as a local child process without a shell.
# Install the maintained `coqui-tts` package and point this to its `tts` executable
# when that executable is not already available on PATH.
AUTO_GENERATE_INCIDENT_VOICE="false"
ENABLE_LLM_TRANSLATION="false"
COQUI_TTS_COMMAND="tts"
COQUI_TTS_TIMEOUT_MS="180000"

# Local OpenAI Whisper + Coqui gRPC worker (compose.yaml starts this sidecar).
# No OpenAI API key is required. Never put the service token in frontend variables.
SPEECH_GRPC_ENDPOINT=""
SPEECH_SERVICE_ACCESS_TOKEN=""
# Multilingual model: tiny, base, small, medium, large or turbo (never *.en).
WHISPER_MODEL="base"
BARK_MODEL="suno/bark-small"
BARK_VOICE_PRESET="v2/en_speaker_6"
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="cloudzero-qwen3:4b-q4_K_M"
OLLAMA_FALLBACK_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_MS="60000"

# External writes stay off in simulation. In LIVE mode, each integration also
# requires its enable flag and a narrowly scoped credential.
ENABLE_SERVICENOW_WORK_NOTES="false"
ENABLE_BRIDGE_AUDIO_PUBLISH="false"
BRIDGE_AUDIO_RELAY_URL=""
BRIDGE_AUDIO_RELAY_TOKEN=""

# Phase 3 starts in shadow mode. Set false only after evaluation gates pass.
AGENT_SHADOW_MODE="true"
AUTONOMY_MINIMUM_SAMPLES="20"
AUTONOMY_MIN_ACCURACY="0.90"
AUTONOMY_MAX_ROLLBACK_RATE="0.05"
AUTONOMY_MAX_FALSE_POSITIVE_RATE="0.03"
AUTONOMY_MIN_ACCEPTANCE="0.80"

# Phase 4 allowlisted executor. Store both values in Secret Manager in production.
PRODUCTION_EXECUTOR_URL=""
PRODUCTION_EXECUTOR_TOKEN=""
EXECUTION_EVIDENCE_MAX_AGE_MS="900000"

# Legacy simulation webhook credential. The production-hardened profile
# disables this route; never place a real value in source control.
WEBHOOK_ACCESS_TOKEN=""

# Quantum-inspired classical runtime. Q1 defaults to SHADOW and cannot change
# recommendation confidence until explicitly promoted to ASSISTED.
QI_EVIDENCE_INTERFERENCE_MODE="SHADOW"
QI_EVIDENCE_INTERFERENCE_TIMEOUT_MS="100"
QI_EVIDENCE_INTERFERENCE_MAX_CANDIDATES="1000"
QI_EVIDENCE_INTERFERENCE_MAX_ITERATIONS="100"
QI_EVIDENCE_INTERFERENCE_VERSION="1.0.0"

# Q2 deterministic beam search. Shadow output never changes remediation choice.
QI_HYPOTHESIS_SEARCH_MODE="SHADOW"
QI_HYPOTHESIS_SEARCH_TIMEOUT_MS="150"
QI_HYPOTHESIS_SEARCH_MAX_CANDIDATES="100"
QI_HYPOTHESIS_SEARCH_MAX_ITERATIONS="3"
QI_HYPOTHESIS_SEARCH_VERSION="1.0.0"

# Q3 versioned counterfactual model. Always includes a NO_ACTION baseline.
QI_COUNTERFACTUAL_SIMULATION_MODE="SHADOW"
QI_COUNTERFACTUAL_SIMULATION_TIMEOUT_MS="150"
QI_COUNTERFACTUAL_SIMULATION_MAX_CANDIDATES="3"
QI_COUNTERFACTUAL_SIMULATION_MAX_ITERATIONS="1"
QI_COUNTERFACTUAL_SIMULATION_VERSION="1.0.0"

# Q4 bounded responder and change planning; both remain recommendation-only.
QI_ANNEALING_ASSIGNMENT_MODE="SHADOW"
QI_ANNEALING_ASSIGNMENT_TIMEOUT_MS="150"
QI_ANNEALING_ASSIGNMENT_MAX_CANDIDATES="100"
QI_ANNEALING_ASSIGNMENT_MAX_ITERATIONS="250"
QI_ANNEALING_ASSIGNMENT_VERSION="1.0.0"
QI_CHANGE_COLLISION_MODE="SHADOW"
QI_CHANGE_COLLISION_TIMEOUT_MS="100"
QI_CHANGE_COLLISION_MAX_CANDIDATES="100"
QI_CHANGE_COLLISION_MAX_ITERATIONS="1"
QI_CHANGE_COLLISION_VERSION="1.0.0"

# Q5 auditable QUBO portfolio planner. This does not expand executor actions.
# Observability: user-agreed incident resolution commitments, 24x7 elapsed time.
TWIN_SLA_P1_RESOLUTION_SECONDS=3600
# Separate SQL-backed A2A demo; compose.yaml provides its isolated instance and restricted roles.
# Requires DEPLOYMENT_PROFILE=LOCAL_SIMULATION and OPERATING_MODE=SIMULATION.
ENABLE_A2A_DB_DEMO=false
DEMO_SEED_CATALOG=false
DEMO_DATABASE_URL=
TWIN_SLA_P2_RESOLUTION_SECONDS=28800
# P3 deliberately unconfigured; set only when agreed.
TWIN_SLA_P3_RESOLUTION_SECONDS=
GRAFANA_PUBLIC_URL=http://localhost:3001/d/cloudzero-twins
# Dedicated scrape token; local compose supplies its development-only value.
TWIN_METRICS_TOKEN=
# Actual client journey telemetry. Leave unset until the collector/targets are agreed.
WIRELESS_XLA_INGEST_TOKEN=
XLA_ROAM_INTERRUPTION_MS=
XLA_ROAM_PACKET_LOSS_PERCENT=
XLA_ROAM_LATENCY_MS=

QI_QUBO_PLANNER_MODE="SHADOW"
QI_QUBO_PLANNER_TIMEOUT_MS="150"
QI_QUBO_PLANNER_MAX_CANDIDATES="20"
QI_QUBO_PLANNER_MAX_ITERATIONS="500"
QI_QUBO_PLANNER_VERSION="1.0.0"
